# Where the Rove API (./backend) is running
EXPO_PUBLIC_API_URL=http://localhost:8010

# Auth0 — all three are required together. Leave any of them blank and the app
# runs as the local dev user, which the backend allows only while AUTH0_DOMAIN
# is unset there too. See docs/auth0.md for the dashboard setup.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-5kw4mmxo44z4bhii.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://rove.api

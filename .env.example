# Where the Rove API (./backend) is running
EXPO_PUBLIC_API_URL=http://localhost:8010

# Auth0 — optional. Without these the app talks to the API as the local dev
# user, which the backend allows only while AUTH0_DOMAIN is unset there too.
EXPO_PUBLIC_AUTH0_DOMAIN=
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://rove.api

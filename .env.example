# Auth0 — the Native application you registered under Applications
EXPO_PUBLIC_AUTH0_DOMAIN=your-tenant.us.auth0.com
EXPO_PUBLIC_AUTH0_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Must match AUTH0_AUDIENCE on the server
EXPO_PUBLIC_AUTH0_AUDIENCE=https://rove.api

# Where the Rove API is running
EXPO_PUBLIC_API_URL=http://localhost:4000

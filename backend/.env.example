# --- MongoDB -------------------------------------------------------------
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Local docker (see docker-compose.yml): mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=rove

# --- Auth0 ---------------------------------------------------------------
# Leave AUTH0_DOMAIN blank to run open (every request is the dev user) —
# handy before Auth0 is set up. Never do that outside local development.
AUTH0_DOMAIN=
AUTH0_AUDIENCE=https://rove.api

# --- Server --------------------------------------------------------------
PORT=8010
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:4173,http://localhost:3000

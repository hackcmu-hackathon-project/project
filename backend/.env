# Committed on purpose — private repo, and nothing here is a secret. Put real
# credentials (an Atlas URI with a password, a client secret) in .env.local,
# which is ignored and overrides nothing you see here.

# --- MongoDB -------------------------------------------------------------
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority
# Local docker (see docker-compose.yml): mongodb://localhost:27017
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=rove

# --- Auth0 ---------------------------------------------------------------
# Leave AUTH0_DOMAIN blank to run open (every request is the dev user) —
# handy before Auth0 is set up. Never do that outside local development.
AUTH0_DOMAIN=dev-5kw4mmxo44z4bhii.us.auth0.com
AUTH0_AUDIENCE=
AUTH0_CLIENT_ID=UWaMoWvHRhrHTgmFVpxUvqBE3ikMoMty

# --- Server --------------------------------------------------------------
PORT=8010
CORS_ORIGINS=http://localhost:8081,http://localhost:19006,http://localhost:4173,http://localhost:3000

# Free tier: 15 requests/min, 500/day — far more room than 3.8 Flash (5/min, 20/day).
GEMINI_MODEL=gemini-3.1-flash-lite
